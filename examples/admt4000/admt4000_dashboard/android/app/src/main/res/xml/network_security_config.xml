<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain http/ws traffic to the local admt4000_bridge.py service,
     which is not served over TLS since it only runs on a trusted LAN. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
